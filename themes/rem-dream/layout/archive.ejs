<%
  let ribbonTitle = '文章目录';
  let ribbonEn = 'LIBRARY';
  let ribbonIcon = 'flow';
  if (page.category === '技术') {
    ribbonTitle = '技术';
    ribbonEn = 'DATA LOAD';
    ribbonIcon = 'folder';
  } else if (page.category === '生活') {
    ribbonTitle = '生活';
    ribbonEn = 'CONTINUE';
    ribbonIcon = 'bookmark';
  } else if (page.category === '自创文') {
    ribbonTitle = '自创文';
    ribbonEn = 'EXTRA MODE';
    ribbonIcon = 'extra';
  } else if (page.tag) {
    ribbonTitle = page.tag;
    ribbonEn = 'TAG';
    ribbonIcon = 'star';
  } else if (page.year) {
    ribbonTitle = String(page.year);
    ribbonEn = 'ARCHIVE';
    ribbonIcon = 'book';
  }
%>
<section class="inner-screen is-page">
  <%- partial('_partial/inner-header', { title: ribbonTitle, en: ribbonEn, icon: ribbonIcon }) %>
  <div class="inner-panel">
    <div class="save-list">
      <% if (page.posts && page.posts.length) { %>
        <% page.posts.each(function(post) { %>
          <%- partial('_partial/post-row', { post: post }) %>
        <% }); %>
      <% } else { %>
        <div class="no-data">NO DATA<br><small>HINO BLOG</small></div>
      <% } %>
    </div>
  </div>
</section>
