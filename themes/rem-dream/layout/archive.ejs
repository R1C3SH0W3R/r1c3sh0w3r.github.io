<% const listingTitle = page.category ? '分类：' + page.category : (page.tag ? '标签：' + page.tag : (page.title || '文章归档')); %>
<section class="listing-page">
  <div class="section-heading">
    <h1 class="section-title"><%= listingTitle %></h1>
  </div>
  <div class="post-list">
    <% page.posts.each(function(post) { %>
      <article class="post">
        <div class="post-meta">
          <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY 年 M 月 D 日') %></time>
          <% if (post.categories && post.categories.length) { %>
            <% post.categories.each(function(category) { %>
              <a class="post-category" href="<%- url_for(category.path) %>"><%= category.name %></a>
            <% }); %>
          <% } %>
        </div>
        <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
        <a class="read-more" href="<%- url_for(post.path) %>">阅读文章</a>
      </article>
    <% }); %>
  </div>
</section>
