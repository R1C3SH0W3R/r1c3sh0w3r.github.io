<!doctype html>
<html lang="zh-CN">
<%
  const isPost = page.layout === 'post';
  const isHome = is_home();
  const layoutName = isHome ? 'index' : (page.layout || 'page');
  const seoTitle = page.title ? page.title + ' · ' + config.title : config.title;
  const rawDescription = page.description || page.excerpt || config.description || seoTitle;
  const cleanDescription = strip_html(String(rawDescription)).replace(/\s+/g, ' ').trim();
  const seoDescription = cleanDescription.length > 160 ? cleanDescription.slice(0, 157) + '...' : cleanDescription;
  const canonicalUrl = page.canonical || full_url_for(page.path || '');
  const siteHome = full_url_for('/');
  const seoImage = full_url_for(page.cover || '/assets/video/transition-poster.jpg');
  const seoKeywords = [];
  const initialView = isHome ? 'boot' : 'inner';

  if (Array.isArray(config.keywords)) {
    config.keywords.forEach(function(keyword) {
      if (keyword) seoKeywords.push(String(keyword));
    });
  } else if (config.keywords) {
    seoKeywords.push(String(config.keywords));
  }

  if (page.tags && page.tags.length && typeof page.tags.each === 'function') {
    page.tags.each(function(tag) {
      if (tag.name && !seoKeywords.includes(tag.name)) seoKeywords.push(tag.name);
    });
  }

  const schemaGraph = [{
    '@type': 'WebSite',
    '@id': siteHome + '#website',
    url: siteHome,
    name: config.title,
    description: config.description,
    inLanguage: config.language || 'zh-CN',
    author: {
      '@type': 'Person',
      name: config.author
    }
  }];

  if (isPost) {
    const articleCategories = [];
    if (page.categories && page.categories.length && typeof page.categories.each === 'function') {
      page.categories.each(function(category) {
        if (category.name) articleCategories.push(category.name);
      });
    }

    schemaGraph.push({
      '@type': 'BlogPosting',
      '@id': canonicalUrl + '#article',
      headline: page.title,
      description: seoDescription,
      url: canonicalUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      isPartOf: {
        '@id': siteHome + '#website'
      },
      image: [seoImage],
      datePublished: date_xml(page.date),
      dateModified: date_xml(page.updated || page.date),
      inLanguage: config.language || 'zh-CN',
      articleSection: articleCategories.join(', '),
      keywords: seoKeywords.join(', '),
      author: {
        '@type': 'Person',
        name: config.author
      },
      publisher: {
        '@type': 'Person',
        name: config.author
      }
    });
  }

  const structuredData = {
    '@context': 'https://schema.org',
    '@graph': schemaGraph
  };
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= seoDescription %>">
  <meta name="keywords" content="<%= seoKeywords.join(', ') %>">
  <meta name="author" content="<%= config.author %>">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="google-site-verification" content="ZkzxbmnlOFWyyPQ5T8_mFFwb5BC-HUM4pwW-9-A6RiA">
  <meta name="theme-color" content="#f3ead8">

  <link rel="canonical" href="<%= canonicalUrl %>">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="<%= full_url_for('/sitemap.xml') %>">
  <link rel="icon" href="<%- url_for('/favicon.png') %>" type="image/png">

  <meta property="og:type" content="<%= isPost ? 'article' : 'website' %>">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="<%= seoImage %>">
  <% if (isPost) { %>
    <meta property="article:published_time" content="<%= date_xml(page.date) %>">
    <meta property="article:modified_time" content="<%= date_xml(page.updated || page.date) %>">
  <% } %>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <meta name="twitter:image" content="<%= seoImage %>">

  <title><%= seoTitle %></title>
  <script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\u003c') %></script>
  <link rel="stylesheet" href="<%- url_for('/live2d/css/live2d.css') %>">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body class="gal-app layout-<%= layoutName %>" data-view="<%= initialView %>">
  <div id="gal-fx" class="gal-fx" aria-hidden="true">
    <video id="gal-fx-video" muted loop playsinline preload="auto" poster="<%- url_for('/assets/video/transition-poster.jpg') %>">
      <source src="<%- url_for('/assets/video/transition.mp4') %>" type="video/mp4">
    </video>
  </div>
  <div id="tsparticles" aria-hidden="true"></div>

  <div class="gal-window" role="presentation">
    <main id="top">
      <%- body %>
    </main>
  </div>

  <div id="gal-preview" class="continue-preview" hidden></div>

  <div id="gal-trans" class="gal-trans" hidden aria-hidden="true"></div>

  <aside class="music-dock" data-music-dock>
    <div class="music-panel">
      <ul class="music-list">
        <li><button type="button" data-track="0">南山南</button></li>
        <li><button type="button" data-track="1">沙龙</button></li>
        <li><button type="button" data-track="2">赤青</button></li>
        <li><button type="button" data-track="3">郭源潮</button></li>
      </ul>
      <div class="music-controls">
        <button type="button" data-music-prev aria-label="上一首">⏮</button>
        <button type="button" data-music-play aria-label="播放">▶</button>
        <button type="button" data-music-next aria-label="下一首">⏭</button>
      </div>
    </div>
    <button class="music-toggle" type="button" data-music-toggle aria-label="打开播放器" aria-expanded="false">♪</button>
    <audio id="gal-audio" preload="auto"></audio>
    <script type="application/json" id="music-tracks">
      [
        {"title":"南山南","src":<%- JSON.stringify(url_for('/assets/music/南山南.mp3')) %>},
        {"title":"沙龙","src":<%- JSON.stringify(url_for('/assets/music/沙龙.mp3')) %>},
        {"title":"赤青","src":<%- JSON.stringify(url_for('/assets/music/赤青.m4a')) %>},
        {"title":"郭源潮","src":<%- JSON.stringify(url_for('/assets/music/郭源潮.m4a')) %>}
      ]
    </script>
  </aside>

  <aside class="visitor-counter" data-visitor-counter aria-label="本站累计访问次数">
    <span class="visitor-counter-label">累计访问</span>
    <strong id="busuanzi_site_pv" data-visitor-value aria-live="polite">加载中</strong>
    <span class="visitor-counter-unit">次</span>
  </aside>

  <div id="rembox">
    <div id="landlord">
      <div class="message" style="opacity:0"></div>
      <canvas id="live2d" width="500" height="560" class="live2d"></canvas>
      <input name="live_talk" id="live_talk" value="1" type="hidden">
    </div>
    <div id="open_live2d"></div>
  </div>

  <script src="<%- url_for('/live2d/js/jquery.min.js') %>"></script>
  <script src="<%- url_for('/live2d/js/live2d.js') %>"></script>
  <script src="<%- url_for('/live2d/js/message.js') %>"></script>
  <script src="<%- url_for('/assets/vendor/tsparticles/tsparticles.engine.min.js') %>"></script>
  <script src="<%- url_for('/assets/vendor/tsparticles/tsparticles.bundle.min.js') %>"></script>
  <script src="https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" defer></script>
  <script src="<%- url_for('/js/effects.js') %>?v=20261002b"></script>
  <script src="<%- url_for('/js/galgame.js') %>?v=20261002b"></script>
</body>
</html>
