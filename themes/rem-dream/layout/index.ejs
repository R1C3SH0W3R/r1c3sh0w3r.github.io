<section class="hero">
  <div class="hero-copy">
    <div class="eyebrow"><span class="eyebrow-dot"></span><%= theme.hero_eyebrow %></div>
    <h1><%= theme.hero_title %></h1>
    <p><%= theme.hero_text %></p>
  </div>

  <aside class="profile" id="about">
    <div class="avatar"><%= theme.profile.avatar_text %></div>
    <h2><%= theme.profile.title %></h2>
    <p><%= theme.profile.description %></p>
    <div class="tags">
      <% theme.profile.tags.forEach(function(tag) { %>
        <span class="tag"><%= tag %></span>
      <% }); %>
    </div>
  </aside>
</section>

<section id="posts">
  <div class="section-heading">
    <h2 class="section-title"><%= theme.posts_title %></h2>
  </div>

  <div class="grid">
    <div class="post-list">
      <% if (page.posts.length) { %>
        <% page.posts.each(function(post) { %>
          <% const summary = post.description || strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').trim().slice(0, 130); %>
          <% const categories = post.categories ? post.categories.map(function(category) { return category; }) : []; %>
          <article class="post">
            <div class="post-meta">
              <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY 年 M 月 D 日') %></time>
              <% if (categories.length) { %>
                <a class="post-category" href="<%- url_for(categories[0].path) %>"><%= categories[0].name %></a>
              <% } %>
            </div>
            <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
            <p><%= summary %><%= summary.length >= 130 ? '…' : '' %></p>
            <a class="read-more" href="<%- url_for(post.path) %>">阅读文章</a>
          </article>
        <% }); %>
      <% } else { %>
        <article class="post empty-state">
          <h3>文章正在准备中</h3>
          <p>第一篇记录很快就会出现在这里。</p>
        </article>
      <% } %>

      <% const currentPage = page.current || 1; %>
      <% const totalPages = page.total || 1; %>
      <% if (totalPages > 1) { %>
        <%
          const pageHref = function(pageNumber) {
            const target = pageNumber === 1 ? url_for('/') : url_for(config.pagination_dir + '/' + pageNumber + '/');
            return target + '#posts';
          };
          let pageStart = Math.max(1, currentPage - 2);
          let pageEnd = Math.min(totalPages, pageStart + 4);
          pageStart = Math.max(1, pageEnd - 4);
          const visiblePages = [];
          for (let pageNumber = pageStart; pageNumber <= pageEnd; pageNumber += 1) {
            visiblePages.push(pageNumber);
          }
        %>
        <nav
          class="pagination"
          aria-label="文章分页"
          data-pagination
          data-pagination-root="<%- url_for('/') %>"
          data-pagination-dir="<%= config.pagination_dir %>"
          data-total-pages="<%= totalPages %>"
        >
          <div class="pagination-links">
            <% if (currentPage > 1) { %>
              <a class="pagination-edge" href="<%- pageHref(1) %>" title="返回第一页">首页</a>
              <a class="pagination-step" href="<%- pageHref(currentPage - 1) %>" rel="prev">上一页</a>
            <% } else { %>
              <span class="pagination-edge is-disabled" aria-disabled="true">首页</span>
              <span class="pagination-step is-disabled" aria-disabled="true">上一页</span>
            <% } %>

            <span class="pagination-numbers" aria-label="页码">
              <% visiblePages.forEach(function(pageNumber) { %>
                <% if (pageNumber === currentPage) { %>
                  <span class="pagination-number is-current" aria-current="page"><%= pageNumber %></span>
                <% } else { %>
                  <a class="pagination-number" href="<%- pageHref(pageNumber) %>" aria-label="第 <%= pageNumber %> 页"><%= pageNumber %></a>
                <% } %>
              <% }); %>
            </span>

            <% if (currentPage < totalPages) { %>
              <a class="pagination-step" href="<%- pageHref(currentPage + 1) %>" rel="next">下一页</a>
              <a class="pagination-edge" href="<%- pageHref(totalPages) %>" title="前往最后一页">尾页</a>
            <% } else { %>
              <span class="pagination-step is-disabled" aria-disabled="true">下一页</span>
              <span class="pagination-edge is-disabled" aria-disabled="true">尾页</span>
            <% } %>
          </div>

          <form class="pagination-jump" data-pagination-jump>
            <label for="page-jump-<%= currentPage %>">跳至</label>
            <input
              id="page-jump-<%= currentPage %>"
              name="page"
              type="number"
              min="1"
              max="<%= totalPages %>"
              value="<%= currentPage %>"
              inputmode="numeric"
              aria-label="输入页码，共 <%= totalPages %> 页"
            >
            <span aria-hidden="true">/ <%= totalPages %></span>
            <button type="submit">前往</button>
          </form>
        </nav>
      <% } %>
    </div>

    <aside>
      <% const calendarPostDates = site.posts.map(function(post) { return date(post.date, 'YYYY-MM-DD'); }); %>
      <div class="side-box calendar-widget" data-calendar data-post-dates="<%= calendarPostDates.join(',') %>">
        <div class="calendar-header">
          <button class="calendar-nav" type="button" data-calendar-prev aria-label="上一个月" title="上一个月">‹</button>
          <h3 data-calendar-title aria-live="polite"></h3>
          <button class="calendar-nav" type="button" data-calendar-next aria-label="下一个月" title="下一个月">›</button>
        </div>
        <div class="calendar-weekdays" aria-hidden="true">
          <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
        </div>
        <div class="calendar-days" data-calendar-days role="grid"></div>
        <div class="calendar-footer">
          <button type="button" class="calendar-today" data-calendar-today>今天</button>
          <time data-calendar-date></time>
        </div>
      </div>

      <div class="side-box">
        <h3>关于这个博客</h3>
        <p><%= theme.about_text %></p>
      </div>

      <div class="side-box" id="links">
        <h3>常用链接</h3>
        <ul>
          <% theme.links.forEach(function(link) { %>
            <li><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.name %></a></li>
          <% }); %>
        </ul>
      </div>
    </aside>
  </div>
</section>

<section id="projects">
  <div class="section-heading">
    <h2 class="section-title">项目与计划</h2>
  </div>

  <div class="projects">
    <% theme.projects.forEach(function(project) { %>
      <article class="project">
        <h3><%= project.title %></h3>
        <p><%= project.description %></p>
      </article>
    <% }); %>
  </div>
</section>
