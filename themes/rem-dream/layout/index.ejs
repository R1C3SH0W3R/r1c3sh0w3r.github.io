<%
  const posts = site.posts.sort('date', -1).toArray();
  const latest = posts[0];
  const byCategory = function(name) {
    return posts.filter(function(post) {
      return post.categories && post.categories.toArray().some(function(category) {
        return category.name === name;
      });
    });
  };
  const techPosts = byCategory('技术');
  const lifePosts = byCategory('生活');
  const storyPosts = byCategory('自创文');
  const categoryPath = function(name) {
    const found = site.categories.toArray().find(function(category) {
      return category.name === name;
    });
    return found ? url_for(found.path) : url_for('/categories/' + name + '/');
  };
  const previewOf = function(post) {
    if (!post) return null;
    const cats = post.categories ? post.categories.toArray() : [];
    return {
      title: post.title,
      href: url_for(post.path),
      date: date(post.date, 'YYYY/MM/DD HH:mm'),
      cat: cats.length ? cats[0].name : '未分类',
      quote: '「' + post.title + '」'
    };
  };
  const previews = {
    start: previewOf(latest),
    tech: previewOf(techPosts[0]),
    life: previewOf(lifePosts[0]),
    story: previewOf(storyPosts[0])
  };
  const calendarPostDates = site.posts.toArray().map(function(post) { return date(post.date, 'YYYY-MM-DD'); });
%>

<section class="boot-screen" data-screen="boot">
  <div class="boot-hud">
    <p class="boot-brand">绯野のblog</p>
    <div class="boot-bar" aria-hidden="true"><i></i></div>
    <p class="boot-loading">NOW LOADING</p>
  </div>
</section>

<section class="welcome-screen" data-screen="welcome" hidden>
  <p class="welcome-line" data-welcome-text="你好，欢迎来到绯野のblog"></p>
  <p class="welcome-hint" hidden>双击进入</p>
</section>

<section class="title-screen" data-screen="title" hidden>
  <div class="title-logo">
    <img src="<%- url_for('/img/gal/logo-pixel.png') %>" alt="<%= theme.brand || config.title %>">
    <p class="title-sub"><%= theme.hero_title || config.subtitle || '' %></p>
  </div>

  <nav class="title-menu" aria-label="标题界面">
    <a class="title-item" href="<%- latest ? url_for(latest.path) : url_for('/') %>" data-wipe data-preview="start">
      <%- partial('_partial/icon', { name: 'star' }) %>
      <span>
        <strong>开始阅读</strong>
        <small>NEW GAME</small>
      </span>
    </a>
    <a class="title-item" href="<%- categoryPath('技术') %>" data-wipe data-preview="tech">
      <%- partial('_partial/icon', { name: 'folder' }) %>
      <span>
        <strong>技术</strong>
        <small>DATA LOAD</small>
      </span>
    </a>
    <a class="title-item" href="<%- categoryPath('生活') %>" data-wipe data-preview="life">
      <%- partial('_partial/icon', { name: 'bookmark' }) %>
      <span>
        <strong>生活</strong>
        <small>CONTINUE</small>
      </span>
    </a>
    <a class="title-item" href="<%- categoryPath('自创文') %>" data-wipe data-preview="story">
      <%- partial('_partial/icon', { name: 'extra' }) %>
      <span>
        <strong>自创文</strong>
        <small>EXTRA MODE</small>
      </span>
    </a>
    <button class="title-item" type="button" data-screen-target="library">
      <%- partial('_partial/icon', { name: 'flow' }) %>
      <span>
        <strong>文章目录</strong>
        <small>FLOWCHART</small>
      </span>
    </button>
    <button class="title-item" type="button" data-screen-target="about">
      <%- partial('_partial/icon', { name: 'book' }) %>
      <span>
        <strong>关于本站</strong>
        <small>AFTER STORY</small>
      </span>
    </button>
    <button class="title-item" type="button" data-screen-target="config">
      <%- partial('_partial/icon', { name: 'gear' }) %>
      <span>
        <strong>系统设置</strong>
        <small>SYSTEM CONFIG</small>
      </span>
    </button>
  </nav>

  <div class="side-box calendar-widget" data-calendar data-post-dates="<%= calendarPostDates.join(',') %>">
    <div class="calendar-header">
      <button class="calendar-nav" type="button" data-calendar-prev aria-label="上一个月" title="上一个月">‹</button>
      <h3 data-calendar-title aria-live="polite"></h3>
      <button class="calendar-nav" type="button" data-calendar-next aria-label="下一个月" title="下一个月">›</button>
    </div>
    <div class="calendar-weekdays" aria-hidden="true">
      <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
    </div>
    <div class="calendar-days" data-calendar-days role="grid"></div>
    <div class="calendar-footer">
      <button type="button" class="calendar-today" data-calendar-today>今天</button>
      <time data-calendar-date></time>
    </div>
  </div>
</section>

<section class="inner-screen" data-screen="library" hidden>
  <%- partial('_partial/inner-header', { title: '文章目录', en: 'FLOWCHART', icon: 'flow', stay: true }) %>
  <div class="inner-panel">
    <div class="save-list">
      <% if (posts.length) { %>
        <% posts.forEach(function(post) { %>
          <%- partial('_partial/post-row', { post: post }) %>
        <% }); %>
      <% } else { %>
        <div class="no-data">NO DATA<br><small>HINO BLOG</small></div>
      <% } %>
    </div>
  </div>
</section>

<section class="inner-screen" data-screen="about" hidden>
  <%- partial('_partial/inner-header', { title: '关于本站', en: 'AFTER STORY', icon: 'book', stay: true }) %>
  <div class="inner-panel about-panel">
    <p class="about-lead"><%= theme.about_text %></p>
    <p class="about-lead"><%= theme.hero_text %></p>
    <div class="after-cards">
      <a class="after-card" href="<%- categoryPath('技术') %>" data-wipe>
        <strong>技术</strong>
        <small>TECH</small>
        <span><%= techPosts.length %> 篇</span>
      </a>
      <a class="after-card" href="<%- categoryPath('生活') %>" data-wipe>
        <strong>生活</strong>
        <small>LIFE</small>
        <span><%= lifePosts.length %> 篇</span>
      </a>
      <a class="after-card" href="<%- categoryPath('自创文') %>" data-wipe>
        <strong>自创文</strong>
        <small>STORY</small>
        <span><%= storyPosts.length %> 篇</span>
      </a>
    </div>
    <% if (theme.links && theme.links.length) { %>
      <ul class="about-links">
        <% theme.links.forEach(function(link) { %>
          <li><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.name %></a></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>

<section class="inner-screen" data-screen="config" hidden>
  <%- partial('_partial/inner-header', { title: '系统设置', en: 'SYSTEM CONFIG', icon: 'gear', stay: true }) %>
  <div class="inner-panel config-panel">
    <label class="config-row">
      <span>鼠标拖尾</span>
      <input type="checkbox" name="gal-trail" data-config-toggle checked>
    </label>
    <label class="config-row">
      <span>点击特效</span>
      <input type="checkbox" name="gal-charm" data-config-toggle checked>
    </label>
    <p class="config-note">配乐还没放进来。若要加和风 BGM，告诉我你想用哪一首、能不能从网上下。</p>
  </div>
</section>

<% Object.keys(previews).forEach(function(key) { %>
  <% const item = previews[key]; %>
  <% if (item) { %>
    <template data-preview-source="<%= key %>">
      <div class="continue-preview-head">Continue</div>
      <div class="continue-preview-body">
        <p class="continue-quote"><%= item.quote %></p>
        <div class="continue-meta">
          <time><%= item.date %></time>
          <span><%= item.cat %></span>
        </div>
      </div>
    </template>
  <% } %>
<% }); %>
